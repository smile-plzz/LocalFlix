<UserControl x:Class="LocalFlix.App.UserControls.TitleCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="170" Height="270" Margin="0,0,16,0" Cursor="Hand" MouseLeftButtonUp="OnCardClicked">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <!-- Poster Image -->
            <Image x:Name="PosterImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Clip>
                    <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0,0,168,268" />
                </Image.Clip>
            </Image>

            <!-- Bottom Gradient Shadow -->
            <Border VerticalAlignment="Bottom" Height="90" CornerRadius="0,0,7,7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#CC0F0F12" Offset="0.5" />
                        <GradientStop Color="#F00F0F12" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Disconnected Drive Indicator Overlay -->
            <Border x:Name="MissingDriveOverlay" Background="#DD1A1A22" CornerRadius="7" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                    <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Drive Not Connected" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Type Badge (Top Right) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#BB0F0F12" CornerRadius="4" Padding="6,2" Margin="8">
                <TextBlock x:Name="TypeBadgeText" Text="MOVIE" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" />
            </Border>

            <!-- Rating Badge (Top Left) -->
            <Border x:Name="RatingBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#DDA37D10" CornerRadius="4" Padding="6,2" Margin="8">
                <TextBlock x:Name="RatingText" Text="★ 8.8" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" />
            </Border>

            <!-- Card Bottom Info -->
            <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                <TextBlock x:Name="TitleText" Text="Movie Title" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="YearText" Text="2024" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>

            <!-- In-Progress Bar (for Continue Watching) -->
            <ProgressBar x:Name="WatchProgressBar" VerticalAlignment="Bottom" Height="3" Background="Transparent" Foreground="{StaticResource AccentRedBrush}" BorderThickness="0" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
