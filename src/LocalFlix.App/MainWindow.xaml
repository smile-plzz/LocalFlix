<Window x:Class="LocalFlix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LocalFlix" Height="760" Width="1240"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                    <TextBlock Text="LOCAL" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Black" />
                    <TextBlock Text="FLIX" Foreground="{StaticResource AccentRedBrush}" FontSize="22" FontWeight="Black" />
                </StackPanel>

                <!-- Mode Switcher (Offline / Online) -->
                <Border Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="20" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentRedBrush}" CornerRadius="16" Padding="14,6">
                            <TextBlock Text="Offline Library" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="Transparent" CornerRadius="16" Padding="14,6" Opacity="0.5" ToolTip="Online streaming section (Phase 2)">
                            <TextBlock Text="Online Stream" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Search Bar -->
                <Border Grid.Column="2" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Height="38" MaxWidth="420" HorizontalAlignment="Right" Margin="0,0,24,0" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged">
                            <TextBox.Resources>
                                <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <Label Content="Search movies, TV shows, actors..." Foreground="#666677" Padding="0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Drives Status / Scan Button -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="+ Scan Folder" Style="{StaticResource AccentButton}" Click="ScanButton_Click" Margin="0,0,12,0" />
                    <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0" />
                            <TextBlock x:Name="DriveStatusText" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar + Dynamic Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="MENU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="16,0,0,12" />
                        <Button x:Name="NavHome" Content="🏠  Home" Style="{StaticResource NavButton}" Tag="Active" Click="NavButton_Click" Margin="0,0,0,4" />
                        <Button x:Name="NavMovies" Content="🎬  Movies" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />
                        <Button x:Name="NavTvShows" Content="📺  TV Shows" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />
                        <Button x:Name="NavDocs" Content="🌍  Documentaries" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />
                        <Button x:Name="NavWatchlist" Content="🔖  Watchlist" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />

                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="12,16" />

                        <TextBlock Text="LIBRARY TOOLS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="16,0,0,12" />
                        <Button x:Name="NavReview" Content="⚠️  Needs Review" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />
                        <Button x:Name="NavDrives" Content="💾  Drives &amp; Roots" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />
                        <Button x:Name="NavSettings" Content="⚙️  Settings" Style="{StaticResource NavButton}" Click="NavButton_Click" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- Footer / Version -->
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="16,0,0,12">
                        <TextBlock Text="LocalFlix v1.0 (Offline)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock Text="Native Media Player" Foreground="#666677" FontSize="10" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}">
                <ContentControl x:Name="MainContentHost" />
            </Border>
        </Grid>
    </Grid>
</Window>
