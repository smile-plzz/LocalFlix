<UserControl x:Class="LocalFlix.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:LocalFlix.App.UserControls"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40">
            <!-- Hero Banner -->
            <Grid x:Name="HeroContainer" Height="360" Margin="0,0,0,24">
                <!-- Hero Backdrop Image -->
                <Image x:Name="HeroBackdrop" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Cinematic Dark Gradient Overlay -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#55000000" Offset="0" />
                            <GradientStop Color="#AA0F0F12" Offset="0.6" />
                            <GradientStop Color="#FF0F0F12" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Left Gradient Vignette -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F00F0F12" Offset="0" />
                            <GradientStop Color="#880F0F12" Offset="0.5" />
                            <GradientStop Color="#000F0F12" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Hero Content -->
                <StackPanel VerticalAlignment="Bottom" Margin="40,0,0,40" MaxWidth="600" HorizontalAlignment="Left">
                    <Border Background="{StaticResource AccentRedBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="FEATURED" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="HeroTitle" Text="LocalFlix Movie" Foreground="{StaticResource TextPrimaryBrush}" FontSize="36" FontWeight="Black" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock x:Name="HeroRating" Text="★ 9.0" Foreground="#FFD700" FontWeight="Bold" FontSize="14" Margin="0,0,14,0" />
                        <TextBlock x:Name="HeroYear" Text="2024" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,14,0" />
                        <TextBlock x:Name="HeroGenres" Text="Action, Sci-Fi" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" />
                    </StackPanel>
                    <TextBlock x:Name="HeroOverview" Text="Featured media overview..." Foreground="#D0D0E0" FontSize="13" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="HeroPlayBtn" Content="▶  Play Now" Style="{StaticResource AccentButton}" Padding="20,10" FontSize="14" Margin="0,0,12,0" Click="HeroPlayBtn_Click" />
                        <Button x:Name="HeroWatchlistBtn" Content="+ Watchlist" Style="{StaticResource CinematicButton}" Padding="16,10" FontSize="14" Click="HeroWatchlistBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Continue Watching Row -->
            <StackPanel x:Name="ContinueWatchingSection" Margin="32,0,0,24" Visibility="Collapsed">
                <TextBlock Text="Continue Watching" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContinueWatchingPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>

            <!-- Recently Added Row -->
            <StackPanel x:Name="RecentlyAddedSection" Margin="32,0,0,24">
                <TextBlock Text="Recently Added" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RecentlyAddedPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>

            <!-- Movies Row -->
            <StackPanel x:Name="MoviesSection" Margin="32,0,0,24">
                <TextBlock Text="Movies" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MoviesPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>

            <!-- TV Shows Row -->
            <StackPanel x:Name="TvShowsSection" Margin="32,0,0,24">
                <TextBlock Text="TV Shows &amp; Series" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TvShowsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>

            <!-- Documentaries Row -->
            <StackPanel x:Name="DocsSection" Margin="32,0,0,24">
                <TextBlock Text="Documentaries" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DocsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
