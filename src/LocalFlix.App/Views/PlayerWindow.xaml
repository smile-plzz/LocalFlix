<Window x:Class="LocalFlix.App.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="LocalFlix Player" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove">
    <Grid Background="#000000">
        <!-- Video View -->
        <vlc:VideoView x:Name="VideoViewControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- Auto-hiding HUD Overlay -->
        <Grid x:Name="HudOverlay">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top HUD Bar -->
            <Border Grid.Row="0" Padding="28,20" Background="#990A0A0E">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="← Exit" Style="{StaticResource CinematicButton}" Grid.Column="0" Click="BackButton_Click" />
                    <TextBlock x:Name="MediaTitleText" Text="Media Title" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Center Resume Prompt Modal -->
            <Border x:Name="ResumePromptModal" Grid.Row="1" Background="#EE121218" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Resume Playback" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="ResumeTimeText" Text="You were watching at 00:45:12" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ResumeButton" Content="Resume" Style="{StaticResource AccentButton}" Padding="20,10" Margin="0,0,12,0" Click="ResumeButton_Click" />
                        <Button x:Name="RestartButton" Content="Start from Beginning" Style="{StaticResource CinematicButton}" Padding="16,10" Click="RestartButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Center Next Episode Prompt Modal -->
            <Border x:Name="NextEpisodePromptModal" Grid.Row="1" Background="#EE121218" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1" CornerRadius="12" Padding="28" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Up Next" Foreground="{StaticResource AccentRedBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock x:Name="NextEpisodeTitleText" Text="Next Episode Title" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="NextCountdownText" Text="Playing in 10s..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PlayNextNowButton" Content="Play Now" Style="{StaticResource AccentButton}" Padding="18,8" Margin="0,0,12,0" Click="PlayNextNowButton_Click" />
                        <Button x:Name="CancelNextButton" Content="Cancel" Style="{StaticResource CinematicButton}" Padding="16,8" Click="CancelNextButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom HUD Controls -->
            <Border Grid.Row="2" Padding="28,20" Background="#DD0A0A0E">
                <StackPanel>
                    <!-- Seek Slider Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="#AAAAAA" FontSize="12" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Cursor="Hand" PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp" ValueChanged="SeekSlider_ValueChanged" />
                        <TextBlock x:Name="TotalTimeText" Text="00:00" Foreground="#AAAAAA" FontSize="12" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <!-- Bottom Controls Row -->
                    <Grid>
                        <!-- Left Controls: Play, Skips -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="PlayPauseButton" Content="⏸" Style="{StaticResource CinematicButton}" Padding="14,6" FontSize="16" Margin="0,0,8,0" Click="PlayPauseButton_Click" />
                            <Button x:Name="SkipBackBtn" Content="↺ 10s" Style="{StaticResource CinematicButton}" Padding="10,6" FontSize="12" Margin="0,0,8,0" Click="SkipBackBtn_Click" />
                            <Button x:Name="SkipForwardBtn" Content="↻ 10s" Style="{StaticResource CinematicButton}" Padding="10,6" FontSize="12" Margin="0,0,16,0" Click="SkipForwardBtn_Click" />

                            <!-- Volume -->
                            <TextBlock Text="🔊" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                        </StackPanel>

                        <!-- Right Controls: Tracks, Speed, Fullscreen -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Audio Track Selector -->
                            <ComboBox x:Name="AudioTracksCombo" Width="120" Background="{StaticResource SurfaceDarkBrush}" Foreground="#FFFFFF" Margin="0,0,8,0" SelectionChanged="AudioTracksCombo_SelectionChanged" ToolTip="Audio Track" />

                            <!-- Subtitle Track Selector -->
                            <ComboBox x:Name="SubtitlesCombo" Width="120" Background="{StaticResource SurfaceDarkBrush}" Foreground="#FFFFFF" Margin="0,0,8,0" SelectionChanged="SubtitlesCombo_SelectionChanged" ToolTip="Subtitles" />

                            <Button Content="Sub -" ToolTip="Subtitles 100 milliseconds earlier" Click="SubtitleEarlier_Click" Style="{StaticResource CinematicButton}" Padding="6" />
                            <Button Content="Sub +" ToolTip="Subtitles 100 milliseconds later" Click="SubtitleLater_Click" Style="{StaticResource CinematicButton}" Padding="6" />
                            <!-- Playback Speed -->
                            <Button x:Name="SpeedButton" Content="1.0x" Style="{StaticResource CinematicButton}" Padding="10,6" FontSize="12" Margin="0,0,8,0" Click="SpeedButton_Click" ToolTip="Playback Speed" />

                            <!-- Fullscreen Button -->
                            <Button x:Name="FullscreenButton" Content="⛶" Style="{StaticResource CinematicButton}" Padding="12,6" FontSize="14" Click="FullscreenButton_Click" ToolTip="Toggle Fullscreen (F)" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
